[Unit]
Description=Cloudflare Tunnel for IF Claims Copilot demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config "/home/david/IF Insurence flow/ops/cloudflared-config.yml" tunnel run
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
